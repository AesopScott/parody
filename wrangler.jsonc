{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parodyai-win",
  "compatibility_date": "2026-06-13",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "parodyai.win",
      "custom_domain": true
    },
    {
      "pattern": "www.parodyai.win",
      "custom_domain": true
    }
  ]
}
